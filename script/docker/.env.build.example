# 仅在需要本地/CI 基于源码构建镜像时使用

# 前端项目源码根目录。
# 1. 如果直接在仓库内执行 script/docker/docker-compose.build.yml，则可保持默认 ../..
# 2. 如果把整个 docker 目录单独拷贝到别处部署，则改成前端项目真实源码路径
APP_BUILD_CONTEXT=../..

# Dockerfile 路径。
# 1. 仓库内执行时默认是 script/docker/app/Dockerfile
# 2. 独立部署目录执行时，改成当前部署目录下的 app/Dockerfile 绝对路径
APP_DOCKERFILE=script/docker/app/Dockerfile

# 构建出的镜像名
AI_CHATBOT_IMAGE=ai-chatbot:latest

# 后端 compose 顶层 name 为 legal 时，默认网络名通常是 legal_ruoyi-net
BACKEND_DOCKER_NETWORK=legal_ruoyi-net

# 前端容器通过后端现有 nginx-web 容器访问 /prod-api，再由 nginx 分发到后端实例
BASE_URL=http://nginx-web/prod-api

# 如需直接从宿主机访问前端容器，可暴露该端口
CHATBOT_PORT=3000
