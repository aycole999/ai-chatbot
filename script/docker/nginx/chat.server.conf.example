# 将以下内容追加到后端现有 nginx 的 http {} 中。
# 原有 worker_processes、events、http 基础参数、已有 upstream 与 server 块都保持不变。
# 推荐给前端单独分配域名，例如 chat.example.com。
# 当前项目未配置 basePath，同域名子路径部署（如 /chat/）会额外涉及 Next.js 路由改造。

upstream ai-chatbot {
    server ai-chatbot:3000;
}

server {
    listen       80;
    server_name  chat.example.com;

    client_max_body_size 10m;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_pass http://ai-chatbot;
    }
}
