# 环境标识：用于 compose project、容器名和内部网络名。
APP_ENV=prod

# Next.js 镜像。可使用同一个 latest 镜像，也可单独构建 prod 标签。
AI_CHATBOT_IMAGE=ai-chatbot:prod

# 后端生产环境 Docker 网络，需与 RuoYi-Vue-Plus-Legal/script/docker/prod/.env 中的 APP_ENV 对齐。
BACKEND_DOCKER_NETWORK=legal-prod-net

# 与 Nginx Proxy Manager 或 frpc 共享的外部网络。
PROXY_DOCKER_NETWORK=proxy-net

# Next.js Route Handlers 访问后端的基础地址。
BASE_URL=http://legal-prod-nginx/prod-api

# ai-chatbot 独立 nginx 入口暴露到宿主机的端口。
AI_CHATBOT_HTTP_PORT=182
